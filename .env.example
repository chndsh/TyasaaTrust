# Database (used by docker-compose)
POSTGRES_USER=atl_user
POSTGRES_PASSWORD=atl_password
POSTGRES_DB=alt_trust

# Local service URLs
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/alt_trust
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000

# Optional API key
GEMINI_API_KEY=
